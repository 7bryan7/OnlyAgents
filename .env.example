# Copy this file to .env. Never commit credentials.
# Required for live task execution, audits, swarm synthesis and feed generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ADMIN_WALLETS=0x2e0113c8806c8bFFd9cAA0861a9D1ffFE66E48A8
DAILY_AI_CALL_LIMIT=100
AI_CONCURRENCY=3
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=60
# Customer review window after a successful output, in hours.
REVIEW_WINDOW_HOURS=48

PORT=8787
APP_ORIGIN=http://localhost:3000
# Leave blank for Vite's /api and /ws proxy, or a same-origin production server.
# For a separate API origin use its absolute http(s) URL, without a trailing slash.
VITE_API_URL=
# Use poll when the frontend proxies /api through Vercel. Default uses WebSockets.
# The Vercel build command sets this automatically; local development is unchanged.
VITE_LIVE_UPDATES=
# Optional absolute path. Defaults to ./data relative to the repository.
DATA_DIR=
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
# Docker HTTPS deployment only: domain without protocol, path or port.
APP_DOMAIN=

# Warm-up makes 18 tasks and up to 9 audits on an empty store; consumes API quota.
WARMUP_ENABLED=false
# Background social feed is opt-in. Manual cycles remain available.
FEED_CYCLE_ENABLED=false
FEED_CYCLE_MS=300000
FEED_CYCLE_COUNT=3

# Optional Base Sepolia mint/hire integration. Not needed for the task runner.
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Public RPC log limits vary. Use a paid RPC for larger historical scans.
RPC_LOG_CHUNK=200
TREASURY_SCAN_BLOCKS=2000
# Contract addresses default to deployed.json. Override after your own deployment.
BASE_SEPOLIA_AGENT_FACTORY=
BASE_SEPOLIA_TASK_ESCROW=
# Original v1 contract for unstamped historical tasks, especially when using
# address overrides. New deployment metadata also preserves this address.
LEGACY_TASK_ESCROW=
# Dedicated delivery operator; contract owner/admin stays in MetaMask.
# Public address used by deployment. Fund it with Base Sepolia testnet ETH.
ESCROW_OPERATOR_ADDRESS=
# Server-only key for delivery attestations, revision holds and automatic release.
# Never use the platform owner's key, and never put this in a VITE_* variable.
ESCROW_OPERATOR_PRIVATE_KEY=
TREASURY=0x2e0113c8806c8bFFd9cAA0861a9D1ffFE66E48A8
OPERATOR_ADDRESS=0x2e0113c8806c8bFFd9cAA0861a9D1ffFE66E48A8
# Put PRIVATE_KEY and optional BASESCAN_API_KEY in a separate .env.deploy file
# on the deployment workstation. Do not ship .env.deploy to the API server.
API_URL=http://localhost:8787
# Deployment only: explicitly replace a legacy factory whose treasury is mutable.
# Existing NFTs remain on the original factory contract.
DEPLOY_NEW_AGENT_FACTORY=false
